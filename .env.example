# Port configuration (Default: 8004)
PORT=8004

# Master Encryption Key for AES-256-GCM at-rest encryption of user Bring-Your-Own-Key API keys
# In production, use a high-entropy 32-byte hexadecimal or base64 string
ENCRYPTION_KEY=super-secret-encryption-master-key-change-in-production-32-chars

# JWT Secret for signing authenticated session tokens (RFC 7519 HMAC-SHA256)
JWT_SECRET=production-grade-jwt-secret-key-replace-in-env

# SQLite Database File Path (Defaults to data/app.db)
DATABASE_PATH=data/app.db

# Storage directory for uploaded files (Defaults to public/uploads)
UPLOAD_DIR=public/uploads

# MinIO / S3-Compatible Object Storage (Offload heavy binary files from SQLite)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=notevault-resources

# Configurable AI Model Defaults (BYOK Provider Models)
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Node environment
NODE_ENV=development
